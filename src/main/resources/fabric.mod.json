{
  "schemaVersion": 1,
  "id": "battery-level",
  "version": "${mod_version}",
  "name": "Battery Level",
  "description": "Show in-game alerts about your battery status",
  "authors": [
    "magicus",
    "Edgeburn Media",
    "Sam Rolfes"
  ],
  "contact": {
    "homepage": "https://github.com/magicus/battery-level",
    "issues": "https://github.com/magicus/battery-level/issues",
    "sources": "https://github.com/magicus/battery-level"
  },
  "license": "MIT",
  "icon": "assets/battery-level/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.edgeburnmedia.batterystatusinfo.client.BatteryStatusInfoModClient"
    ],
    "main": [
      "com.edgeburnmedia.batterystatusinfo.BatteryStatusInfoMod"
    ],
    "modmenu": [
      "com.edgeburnmedia.batterystatusinfo.config.BatteryStatusInfoModMenuIntegration"
    ]
  },
  "mixins": [
    "battery-level.mixins.json"
  ],
  "depends": {
    "minecraft": "${supported_minecraft_versions}",
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "cloth-config":">=${cloth_version}"
  }
}
