{
  "schemaVersion": 1,
  "id": "battery-level",
  "version": "${version}",
  "name": "Battery Level",
  "description": "Show in-game alerts about your battery status",
  "authors": [
    "magicus",
    "Edgeburn Media",
    "Sam Rolfes"
  ],
  "contact": {},
  "license": "MIT",
  "icon": "assets/batterystatusinfo/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.edgeburnmedia.batterystatusinfo.client.BatteryStatusInfoModClient"
